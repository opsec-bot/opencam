{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "opencam camera record",
  "type": "object",
  "required": ["id", "type", "lat", "lon", "sources", "confidence"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable merged id. Prefixed by origin, e.g. osm:node/123456."
    },
    "type": {
      "type": "string",
      "enum": ["speed_camera", "red_light", "alpr", "combined"]
    },
    "lat": {"type": "number", "minimum": -90, "maximum": 90},
    "lon": {"type": "number", "minimum": -180, "maximum": 180},
    "direction": {
      "type": "number",
      "minimum": 0,
      "maximum": 360,
      "description": "Heading the camera faces, degrees clockwise from north. Optional."
    },
    "operator": {"type": "string", "description": "e.g. Flock Safety. Optional."},
    "sources": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "Every source that contributed to this record."
    },
    "firstSeen": {"type": "string", "description": "ISO date, optional."},
    "lastVerified": {"type": "string", "description": "ISO date, optional."},
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Trust score from source count, recency and agreement."
    }
  },
  "additionalProperties": false
}
